NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_DEPLOYMENT_MODE=oss
NEXT_PUBLIC_AUTH_PROVIDER=local

# Disable Stack Auth for local development
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_KEY=

# Posthog (optional - set to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=

# Sentry (optional - set to disable error tracking)
SENTRY_DSN=

# Turn server for WebRTC (optional for local dev)
TURN_HOST=
TURN_USERNAME=
TURN_PASSWORD=
